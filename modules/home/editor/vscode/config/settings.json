{
  // ==================== 界面与显示设置 ====================
  // 编辑器字体栈
  "editor.fontFamily": "FiraCode Nerd Font Mono, Noto Sans CJK SC",
  // 启用字体连字
  "editor.fontLigatures": true,
  // 主题
  "workbench.colorTheme": "Dark+",
  // 工作区图标主题
  "workbench.iconTheme": "material-icon-theme",
  // 自定义文件夹图标
  "material-icon-theme.folders.customClones": [
    {
      "name": "migrations",
      "base": "dal",
      "color": "orange-500",
      "lightColor": "orange-700",
      "folderNames": ["migrations"],
      "rootFolderNames": ["migrations"],
    },
    {
      "name": "account",
      "base": "admin",
      "color": "purple-500",
      "lightColor": "purple-700",
      "folderNames": ["account"],
      "rootFolderNames": ["account"],
    },
    {
      "name": "ai",
      "base": "robot",
      "color": "blue-500",
      "lightColor": "blue-700",
      "folderNames": ["ai"],
      "rootFolderNames": ["ai"],
    },
    {
      "name": "custom_template",
      "base": "template",
      "color": "brown-400",
      "lightColor": "brown-600",
      "folderNames": ["app_template"],
      "rootFolderNames": ["custom_template"],
    },
    {
      "name": "chains",
      "base": "contract",
      "color": "blue-500",
      "lightColor": "blue-700",
      "folderNames": ["chains"],
      "rootFolderNames": ["chains"],
    },
  ],

  // ==================== 编辑器行为 ====================
  // 自动保存策略
  "files.autoSave": "afterDelay",
  // 智能识别文件编码
  "files.autoGuessEncoding": true,
  // 粘贴时自动格式化
  "editor.formatOnPaste": true,
  // 保存时自动格式化
  "editor.formatOnSave": true,
  // 输入时自动格式化
  "editor.formatOnType": true,
  // 默认格式化工具
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.printWidth": 999,
  // 自动换行策略
  "editor.wordWrap": "off",
  // 光标平滑动画效果
  "editor.cursorSmoothCaretAnimation": "on",
  // 鼠标滚轮缩放编辑器
  "editor.mouseWheelZoom": true,
  // 接受建议的快捷键行为
  "editor.acceptSuggestionOnEnter": "smart",
  // 建议项选择策略
  "editor.suggestSelection": "first",
  // 禁止代码片段阻止快速建议
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  // 不显示 Unicode 歧义字符警告
  "editor.unicodeHighlight.ambiguousCharacters": false,
  // 忽略空格差异
  "diffEditor.ignoreTrimWhitespace": false,
  // 默认辅边栏可见性
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  // 关闭未命名工作区保存确认
  "window.confirmSaveUntitledWorkspace": false,
  // 更新后显示版本说明
  "update.showReleaseNotes": false,
  // 编辑器平滑滚动
  "editor.smoothScrolling": true,
  // 列表视图平滑滚动
  "workbench.list.smoothScrolling": true,
  // 终端平滑滚动
  "terminal.integrated.smoothScrolling": true,
  // 默认 Shell
  "terminal.integrated.defaultProfile.linux": "fish",
  // 遇到任务错误时仍继续调试
  "debug.onTaskErrors": "debugAnyway",
  // 在概览标尺中显示断点标记
  "debug.showBreakpointsInOverviewRuler": true,
  // 禁用拖放操作确认
  "explorer.confirmDragAndDrop": false,
  // 禁用文件删除确认
  "explorer.confirmDelete": false,
  // 扩展自动更新
  "extensions.autoUpdate": "off",
  // 文件嵌套规则配置
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
  // 选择单个 git 仓库
  "scm.repositories.selectionMode": "single",

  // ==================== Markdown 相关 ====================
  // Markdown 预览主题
  "markdown-preview-enhanced.previewTheme": "github-light.css",
  // 输出 Markdown 的 Chrome 程序
  "markdown-preview-enhanced.chromePath": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe", // Windows
  // "markdown-preview-enhanced.chromePath": "/opt/microsoft/msedge/msedge", // Linux
  // markdownlint 规则
  "markdownlint.config": {
    "MD024": false, // 禁用重复标题检查
  },

  // ==================== Nix 相关 ====================
  // 默认格式化工具
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
  },
  // 开启语言服务器(LSP)
  "nix.enableLanguageServer": true,
  // 指定 LSP 程序
  "nix.serverPath": "nixd",
  // LSP 的配置
  "nix.serverSettings": {
    "nixd": {
      // 格式化工具
      "formatting": {
        "command": ["nixfmt"],
      },
    },
  },

  // ==================== Python 相关 ====================
  // 显示函数返回类型内联提示
  "python.analysis.inlayHints.functionReturnTypes": true,
  // 显示 pytest 参数内联提示
  "python.analysis.inlayHints.pytestParameters": true,
  // Python 类型检查模式
  "python.analysis.typeCheckingMode": "standard",
  // 定义语言服务器的类型
  "python.languageServer": "Pylance",
  // 默认格式化工具
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
  },
  // 传递给 Black 以格式化 Python 文件的参数
  "black-formatter.args": ["--line-length", "999"],

  // ==================== Cpp 相关 ====================
  // 默认格式化工具
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },

  // ==================== Rust 相关 ====================
  // 默认格式化工具
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
  },

  // ==================== Svelte 相关 ====================
  // 启用 TypeScript Svelte 插件
  "svelte.enable-ts-plugin": true,
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode",
  },
  "prettier.documentSelectors": ["**/*.ripple"],
  "[ripple]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // ==================== 其他设置 ====================
  // 自定义文件关联
  "files.associations": {
    "*tpl": "jinja",
  },
  // indent-rainbow 应该跳过缩进错误检测的语言
  "indentRainbow.ignoreErrorLanguages": ["*"],
}
